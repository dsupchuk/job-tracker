root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# TypeScript / JS / web assets — 2 spaces
[*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml}]
indent_size = 2

# Java — 4 spaces
[*.java]
indent_size = 4

# Markdown — keep trailing whitespace (line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2
